{
  "manifest_version": 3,
  "name": "MEETIX Transcriber",
  "version": "0.1.3",
  "description": "Capture and save live captions from Microsoft Teams and Google Meet meetings on the web.",
  "homepage_url": "https://openix.tech/",
  "icons": {
    "16": "icons/icono-MEETIX-16.png",
    "32": "icons/icono-MEETIX-32.png",
    "48": "icons/icono-MEETIX-48.png",
    "128": "icons/icono-MEETIX-128.png"
  },

  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.office.com/*",
    "https://meet.google.com/*"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icono-MEETIX-16.png",
      "32": "icons/icono-MEETIX-32.png",
      "48": "icons/icono-MEETIX-48.png",
      "128": "icons/icono-MEETIX-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Teams Captions Saver"
  },

  "background": {
    "service_worker": "service_worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.office.com/*"
      ],
      "js": [
        "content_script.js"
      ]
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content_meet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://task-flow-opx-trial.vercel.app/*",
        "https://task-flow-opx-beta.vercel.app/*"
      ],
      "js": [
        "content_meet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "sessionManager.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
